{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kivo-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-03",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "binding": "ASSETS", "directory": ".open-next/assets" },
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
  "vars": { "KIVO_DEMO_MODE": "true", "NEXT_PUBLIC_APP_URL": "https://kivo-web.workers.dev" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kivo-db",
      "database_id": "replace-with-d1-id",
      "migrations_dir": "../../packages/db/migrations",
    },
  ],
  "r2_buckets": [{ "binding": "DOCUMENTS", "bucket_name": "kivo-documents" }],
  "queues": { "producers": [{ "binding": "INGESTION_QUEUE", "queue": "kivo-ingestion" }] },
  "services": [{ "binding": "AI_SERVICE", "service": "kivo-ai-worker" }],
  "analytics_engine_datasets": [{ "binding": "KIVO_ANALYTICS", "dataset": "kivo_events" }],
}
