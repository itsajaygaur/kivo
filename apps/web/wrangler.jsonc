{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kivo-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-03",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "binding": "ASSETS", "directory": ".open-next/assets" },
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
  "vars": {
    "KIVO_DEMO_MODE": "true",
    "NEXT_PUBLIC_APP_URL": "https://kivo-web.ajaypathak2527.workers.dev",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kivo-db",
      "database_id": "69b49a77-87c2-4cf9-a324-0a966e3f5b91",
      "migrations_dir": "../../packages/db/migrations",
    },
  ],
  "queues": { "producers": [{ "binding": "INGESTION_QUEUE", "queue": "kivo-ingestion" }] },
  "services": [{ "binding": "AI_SERVICE", "service": "kivo-ai-worker" }],
}
